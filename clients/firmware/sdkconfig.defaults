# Huxley firmware — curated build defaults.
# Checked in so every developer's build produces the same binary.
# Run `idf.py reconfigure` after editing.
#
# Target is set out-of-band via `idf.py set-target esp32s3` (stored in
# the generated sdkconfig, not here, to avoid collisions with target
# selection).

# -- Flash + partitioning ------------------------------------------------
# Board ships with 16 MB flash. Dual-OTA layout reserved from day 1 so
# adding OTA later is additive, not a reflash migration.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# -- PSRAM (Octal, 8 MB on this board) -----------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Force small allocations (< 16 KB) to internal SRAM — PSRAM is for large
# audio ring buffers, not every tiny heap allocation. Note: this only
# affects heap allocations; static BSS stays internal unless explicitly
# marked with `EXT_RAM_BSS_ATTR` (enabled below).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# Allow explicit BSS-in-PSRAM via `EXT_RAM_BSS_ATTR` so large static
# scratch buffers (base64 decode, future playback ring) don't
# squeeze internal RAM reserved for DMA and FreeRTOS task stacks.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# -- Serial / boot -------------------------------------------------------
# Native USB-CDC so `idf.py monitor` works through the Type-C port without
# a separate UART bridge.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# -- Logging -------------------------------------------------------------
# Runtime default stays at INFO. Compile-time ceiling raised to DEBUG so
# `esp_log_level_set("<tag>", ESP_LOG_DEBUG)` at runtime actually emits
# — with MAXIMUM=DEFAULT the DEBUG calls are compiled out entirely.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT is not set
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# -- Core dumps to flash (panic -> dedicated partition) ------------------
# Decoded on host with `python -m esp_coredump info_corefile` — see
# firmware/docs/debugging.md.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_COREDUMP_LOGS=y

# -- FreeRTOS ------------------------------------------------------------
# 1000 Hz tick so audio frame pacing (20 ms) is a whole number of ticks.
CONFIG_FREERTOS_HZ=1000

# -- Network / Wi-Fi -----------------------------------------------------
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=y

# -- LWIP / TCP ----------------------------------------------------------
# 50 Hz audio × 1.3 KB/frame = 65 KB/s of outbound burst, plus
# inbound audio chunks during model speech. Tuned for sustained
# bidirectional WS audio load.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65535
# Receive side: sized to the Wi-Fi RX buffers (F-0015). Each segment
# lwIP holds pins one Wi-Fi dynamic RX buffer until it's read. With a
# 64 KB window and no cap on the out-of-order queue, one Wi-Fi frame
# lost in a reply burst let 32 later segments wait in the OOSEQ queue
# (seen over JTAG: ooseq=32 segments, 46 KB) and take every RX buffer,
# so the retransmission had nowhere to land: the socket heard nothing
# until keepalive killed it, and the reply stopped mid-sentence.
# Espressif's rule: window (KB) <= dynamic RX buffers; cap OOSEQ.
# 32 KB is still ~10x the audio rate at a 50 ms RTT.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_OOSEQ_MAX_PBUFS=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=40
# The socket's receive mailbox: lwIP's rule is window / MSS + 2 (25 here).
# At the default 6 it held ~8.6 KB, whatever the window said: while the
# WS task was busy with a chunk the mailbox filled, lwIP refused the next
# segments and only retried on its 250 ms TCP timer. Replies arrived at
# 0.65x real time with a ~2 s backlog on the server (late barge-in clears)
# and the speaker ran dry hundreds of times in a long reply (F-0015).
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_TCP_RCV_SCALE=4
# `LWIP_TCPIP_CORE_LOCKING` lets the lwIP TCP/IP thread share its
# critical-section work with calling tasks instead of marshalling
# every API call through a mailbox. Big throughput / latency win for
# our 50 Hz send pattern. Espressif's lwIP perf guide recommends
# this for sustained-traffic apps.
CONFIG_LWIP_TCPIP_CORE_LOCKING=y

# -- esp_websocket_client (managed component) ---------------------------
# Separate TX/RX locks (added in component v1.5.0 via
# espressif/esp-protocols PR #704). Without it, the writer serialises
# against the receive task even when the TCP send window is open,
# producing the `transport_poll_write(0)` close-on-timeout we hit in
# v0.3.1. With it, send and receive proceed independently — required
# for any bidirectional audio workload over WS.
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
# Above WS_SEND_TIMEOUT_MS (5 s, hux_net.c): a mic send waiting for room
# holds the tx lock that long, and the WebSocket task's PONG gives up
# after this and aborts the connection (F-0022 review). Default 2000.
CONFIG_ESP_WS_CLIENT_TX_LOCK_TIMEOUT_MS=6000

# -- Compiler ------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# -- Updates over Wi-Fi (hux_ota) ----------------------------------------
# ESP-IDF app rollback: a new image must confirm itself or the bootloader
# boots the previous one. Plain http:// for images served on the LAN.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y

# The supervisor (F-0027): the task watchdog panics (a core dump, then a
# restart) instead of only logging; 10 s gives the supervisor's stall line
# time to land. Nobody at the home can restart a hung walkie.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
# A dump is kept until read and erased (`coredump erase`): a reset loop
# must not rewrite the same sectors thousands of times a day.
CONFIG_ESP_COREDUMP_FLASH_NO_OVERWRITE=y
