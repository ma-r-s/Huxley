{
  "name": "huxley-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "ios:test": "swiftc -parse-as-library -O ios/App/App/PCM16Resampler.swift ios/tests/ResamplerCheck.swift -o \"${TMPDIR:-/tmp}/huxley-resampler-check\" && \"${TMPDIR:-/tmp}/huxley-resampler-check\""
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "i18next": "^26.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
