# Required
HUXLEY_OPENAI_API_KEY=sk-...

# Optional overrides
# HUXLEY_OPENAI_MODEL=gpt-realtime-2.1   # default gpt-realtime-2.1-mini; full model ~3x audio cost
# HUXLEY_OPENAI_VOICE=coral
# HUXLEY_AUDIO_DEVICE_INDEX=0
# HUXLEY_WAKEWORD_THRESHOLD=0.7
# HUXLEY_LOG_LEVEL=DEBUG
# HUXLEY_PERSONA=abuelos                 # default persona; else the first client's ?persona= picks
# HUXLEY_PERSONA_AT_BOOT=true            # start HUXLEY_PERSONA with the server, not on the first connect (production)
# HUXLEY_AUDIOBOOK_LIBRARY_PATH=data/audiobooks
